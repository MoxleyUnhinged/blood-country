{
  "folders": [{ "path": ".", "name": "Blood Country Toolkit" }],
  "settings": {
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": ["tests"],
    "python.analysis.extraPaths": ["${workspaceFolder}"],
    "editor.formatOnSave": false,
    "files.exclude": {
      "**/__pycache__": true,
      "**/.pytest_cache": true
    },
    "files.associations": { "*.h": "c" },
    "C_Cpp.default.cStandard": "c99",
    "C_Cpp.default.includePath": ["${workspaceFolder}/engine"]
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.vscode-pylance",
      "ms-vscode.cpptools",
      "ms-vscode.makefile-tools"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Run GUI (builds C engine first)",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/main.py",
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal",
        "preLaunchTask": "build C engine"
      },
      {
        "name": "Debug C engine tests",
        "type": "node",
        "request": "launch",
        "program": "${workspaceFolder}/build/test_engine",
        "cwd": "${workspaceFolder}",
        "MIMode": "gdb",
        "preLaunchTask": "build C tests (debug)"
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "build C engine",
        "type": "shell",
        "command": "make",
        "group": { "kind": "build", "isDefault": true },
        "problemMatcher": ["$msCompile"]
      },
      {
        "label": "build C tests (debug)",
        "type": "shell",
        "command": "mkdir -p build && cc -g -O0 -std=c99 -Wall -Wextra -o build/test_engine engine/test_engine.c engine/bc_engine.c",
        "problemMatcher": ["$msCompile"]
      },
      {
        "label": "run C tests",
        "type": "shell",
        "command": "make test",
        "group": "test",
        "problemMatcher": ["$msCompile"]
      },
      {
        "label": "run Python tests",
        "type": "shell",
        "command": "python -m pytest tests",
        "dependsOn": "build C engine",
        "group": "test"
      },
      {
        "label": "clean",
        "type": "shell",
        "command": "make clean"
      }
    ]
  }
}
